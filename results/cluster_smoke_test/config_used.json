{
  "project": {
    "name": "pchpc-project",
    "run_id": "cluster_smoke_test"
  },
  "paths": {
    "data_root": "$PROJECT_DIR/darius/pchpc-project/data",
    "results_root": "results"
  },
  "dataset": {
    "name": "small_random_2560d",
    "num_vectors": 5000,
    "num_queries": 3,
    "dimension": 2560,
    "dtype": "float32",
    "seed": 42,
    "normalize": false
  },
  "search": {
    "backend": "numpy",
    "top_k": 10,
    "similarity": "dot"
  },
  "retrieval": {
    "mode": "mpi_centralized"
  }
}