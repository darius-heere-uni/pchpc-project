{
  "project": {
    "name": "pchpc-project",
    "run_id": "local_per_run_queries_tree"
  },

  "paths": {
    "data_root": "data",
    "results_root": "results"
  },

  "dataset": {
    "name": "small_random_2560d_55q",
    "num_vectors": 5000,
    "num_queries": 55,
    "dimension": 2560,
    "dtype": "float32",
    "seed": 42,
    "normalize": false
  },

  "search": {
    "backend": "faiss",
    "top_k": 10,
    "similarity": "dot",
    "faiss_num_threads": 1
  },

  "retrieval": {
    "mode": "mpi_tree"
  },

  "benchmark": {
    "warmup_runs": 5,
    "measurement_runs": 50,
    "query_policy": "per_run"
  }
}
